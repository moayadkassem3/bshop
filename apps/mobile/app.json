{
  "expo": {
    "name": "Salon Randevu",
    "slug": "salon-randevu",
    "scheme": "salonrandevu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.salonrandevu.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.salonrandevu.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e1013"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "backgroundColor": "#0e1013"
        }
      ],
      "expo-secure-store",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              "./node_modules/@expo-google-fonts/inter/400Regular/Inter_400Regular.ttf",
              "./node_modules/@expo-google-fonts/inter/500Medium/Inter_500Medium.ttf",
              "./node_modules/@expo-google-fonts/inter/600SemiBold/Inter_600SemiBold.ttf",
              "./node_modules/@expo-google-fonts/inter/700Bold/Inter_700Bold.ttf",
              "./node_modules/@expo-google-fonts/inter/800ExtraBold/Inter_800ExtraBold.ttf"
            ]
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Size en yakın kuaförleri göstermek için konumunuz kullanılır."
        }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Salonunuzun ve kesimlerinizin fotoğraflarını eklemek için galerinize erişim gerekir.",
          "cameraPermission": "Salonunuzun ve kesimlerinizin fotoğrafını çekmek için kamera erişimi gerekir.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://salon-randevu-test.onrender.com/api",
      "webUrl": "https://salon-randevu-test.onrender.com"
    }
  }
}
